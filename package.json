{
  "name": "react-native-vibe-store",
  "version": "0.1.0",
  "description": "A tiny, typed, no-provider state store for React Native.",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {"react": ">=18"},
  "devDependencies": {"@types/react": "^19.0.0", "react": "^19.0.0", "tsup": "^9.0.0", "typescript": "^5.7.0", "vitest": "^4.1.12"},
  "publishConfig": {"access": "public"}
}
